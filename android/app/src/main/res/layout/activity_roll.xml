<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/rollTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.16"
        android:text="@string/title"
        android:textColor="@color/amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rollSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/roll_loading"
        android:textColor="@color/dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rollPick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/roll_log" />

        <Button
            android:id="@+id/rollAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/roll_all" />

        <Button
            android:id="@+id/rollNothing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/roll_nothing" />
    </LinearLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:columnWidth="110dp"
        android:horizontalSpacing="6dp"
        android:numColumns="3"
        android:stretchMode="columnWidth"
        android:verticalSpacing="6dp" />

    <ProgressBar
        android:id="@+id/rollBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100" />

    <TextView
        android:id="@+id/rollStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/dim"
        android:textSize="11sp" />

    <Button
        android:id="@+id/rollAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:enabled="false"
        android:text="@string/roll_add_empty"
        android:textStyle="bold" />
</LinearLayout>
